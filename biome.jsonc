// Platform-standard Biome config (one tool for lint + format; exact-pinned
// version so formatting never drifts between repos). Keep this file identical
// across ShipStatic repos; per-repo deviations get a comment explaining why.
{
  "$schema": "https://biomejs.dev/schemas/2.5.5/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "suspicious": {
        // Visible in editors and CI summaries without blocking the build.
        "noExplicitAny": "warn"
      }
    }
  }
}
